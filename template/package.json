{
  "name": "BoilerPlateReactNative",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx",
    "start": "react-native start --reset-cache",
    "start-logs": "npx react-native start --reset-cache --client-logs",
    "reset": "react-native start --reset-cache",
    "test": "jest",
    "asset": "npx react-native-asset",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --coverage",
    "tsc": "node_modules/typescript/bin/tsc --noEmit",
    "precommit": "concurrently 'yarn tsc' 'yarn lint'",
    "android-bundle-release": "react-native build-android --mode=release",
    "android-run-release": "react-native run-android --mode=release",
    "podinstall": "cd ios && bundle exec pod install && cd ..",
    "prepare": "husky"
  },
  "dependencies": {
    "@os-team/i18next-react-native-language-detector": "^1.1.6",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "formik": "^2.4.9",
    "i18next": "^26.5.4",
    "react": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.0",
    "react-native-restart": "^0.0.29",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-is-edge-to-edge": "^1.3.1",
    "react-native-unistyles": "^2.43.0",
    "@react-native/normalize-colors": "0.88.0",
    "react-redux": "^9.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "commitlint": "^21.2.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^5.0.0",
    "react-native-localize": "^3.7.2",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "yarn@1.22.22"
}
